  <build>
    <plugins>
      <!-- Copy WAR files to web/war/ -->
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <!-- Copy WAR artifacts -->
          <execution>
            <id>copy-wars</id>
            <phase>package</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/dist/web/war</outputDirectory>
              <artifactItems>
                <artifactItem>
                  <groupId>${project.groupId}</groupId>
                  <artifactId>mcf-api-service</artifactId>
                  <version>${project.version}</version>
                  <type>war</type>
                  <destFileName>mcf-api-service.war</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>${project.groupId}</groupId>
                  <artifactId>mcf-authority-service</artifactId>
                  <version>${project.version}</version>
                  <type>war</type>
                  <destFileName>mcf-authority-service.war</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>${project.groupId}</groupId>
                  <artifactId>mcf-crawler-ui</artifactId>
                  <version>${project.version}</version>
                  <type>war</type>
                  <destFileName>mcf-crawler-ui.war</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>${project.groupId}</groupId>
                  <artifactId>mcf-combined-service</artifactId>
                  <version>${project.version}</version>
                  <type>war</type>
                  <destFileName>mcf-combined-service.war</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>

          <!-- Copy ManifoldCF framework JARs to lib/ (only core framework, NOT connectors) -->
          <execution>
            <id>copy-framework-jars</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/dist/lib</outputDirectory>
              <includeGroupIds>org.apache.manifoldcf</includeGroupIds>
              <includeArtifactIds>mcf-core,mcf-agents,mcf-pull-agent,mcf-ui-core,mcf-jettyrunner,mcf-scriptengine</includeArtifactIds>
              <excludeTypes>war,pom</excludeTypes>
              <overWriteReleases>false</overWriteReleases>
              <overWriteSnapshots>true</overWriteSnapshots>
            </configuration>
          </execution>

          <!-- Copy third-party runtime JARs to lib/ (jetty, DB drivers, logging, etc.) -->
          <execution>
            <id>copy-lib-thirdparty-jars</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/dist/lib</outputDirectory>
              <includeGroupIds>org.eclipse.jetty,org.eclipse.jetty.toolchain,javax.servlet,org.mortbay.jetty,org.apache.tomcat,org.eclipse.jdt.core.compiler,org.hsqldb,org.postgresql,mysql,org.slf4j,org.apache.logging.log4j,com.googlecode.json-simple,org.apache.httpcomponents,commons-lang,commons-io,commons-codec,commons-el,commons-collections,commons-fileupload,commons-discovery,commons-logging,commons-exec,xalan,xerces,xml-apis,org.apache.velocity,com.google.code.gson,com.google.guava,net.java.dev.jna,com.sun.mail,javax.activation,org.apache.zookeeper,org.apache.commons</includeGroupIds>
              <excludeTypes>war,pom</excludeTypes>
              <overWriteReleases>false</overWriteReleases>
              <overWriteSnapshots>true</overWriteSnapshots>
            </configuration>
          </execution>

          <!-- Copy connector JARs (mcf-*-connector) to connector-lib/ -->
          <execution>
            <id>copy-connector-jars</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/dist/connector-lib</outputDirectory>
              <includeGroupIds>org.apache.manifoldcf</includeGroupIds>
              <includeArtifactIds>
                mcf-cmis-connector,mcf-solr-connector,mcf-nulloutput-connector,mcf-gts-connector,
                mcf-nullauthority-connector,mcf-activedirectory-connector,mcf-web-connector,
                mcf-rss-connector,mcf-jdbc-connector,mcf-filesystem-connector,mcf-wiki-connector,
                mcf-elasticsearch-connector,mcf-amazoncloudsearch-connector,mcf-amazons3-connector,
                mcf-confluence-connector,mcf-confluence-v6-connector,mcf-dropbox-connector,
                mcf-email-connector,mcf-googledrive-connector,mcf-hdfs-connector,mcf-jira-connector,
                mcf-kafka-connector,mcf-ldap-connector,mcf-mongodb-connector,mcf-opensearchserver-connector,
                mcf-searchblox-connector,mcf-sharepoint-connector,mcf-tika-connector,
                mcf-tika-service-connector,mcf-tika-service-rmeta-connector,mcf-alfresco-webscript-connector,
                mcf-generic-connector,mcf-gridfs-connector,mcf-csv-connector,
                mcf-csws-connector,mcf-slack-connector,mcf-rocketchat-connector,mcf-opennlp-connector,
                mcf-html-extractor-connector,mcf-forcedmetadata-connector,mcf-documentfilter-connector,
                mcf-contentlimiter-connector,mcf-nulltransformation-connector,mcf-regexpmapper-connector,
                mcf-ldapmapper-connector,mcf-newgeneric-connector
              </includeArtifactIds>
              <excludeTypes>war,pom</excludeTypes>
            </configuration>
          </execution>

          <!-- Copy third-party connector dependencies to connector-lib/ -->
          <!-- This catches all transitive deps NOT already handled by copy-lib-jars -->
          <!-- e.g. mongo-java-driver, kafka-clients, chemistry-opencmis, hadoop, AWS SDK, Google API, etc. -->
          <execution>
            <id>copy-connector-third-party-deps</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/dist/connector-lib</outputDirectory>
              <excludeGroupIds>
                org.apache.manifoldcf,
                org.eclipse.jetty,org.eclipse.jetty.toolchain,
                javax.servlet,org.mortbay.jetty,
                org.apache.tomcat,org.eclipse.jdt.core.compiler,
                org.hsqldb,org.postgresql,mysql,
                org.slf4j,org.apache.logging.log4j,
                com.googlecode.json-simple,
                org.apache.httpcomponents,
                commons-lang,commons-io,commons-codec,commons-el,
                commons-collections,commons-fileupload,commons-discovery,
                commons-logging,commons-exec,
                xalan,xerces,xml-apis,
                org.apache.velocity,
                com.google.code.gson,com.google.guava,
                net.java.dev.jna,
                com.sun.mail,javax.activation,
                org.apache.zookeeper,
                org.apache.commons
              </excludeGroupIds>
              <excludeTypes>war,pom</excludeTypes>
            </configuration>
          </execution>

          <!-- Copy connector-common and transitive deps to connector-common-lib/ -->
          <execution>
            <id>copy-connector-common-lib</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/dist/connector-common-lib</outputDirectory>
              <includeArtifactIds>mcf-connector-common</includeArtifactIds>
              <includeGroupIds>org.apache.manifoldcf</includeGroupIds>
              <excludeTypes>war,pom</excludeTypes>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Copy runtime resources (config files, scripts) -->
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-dist-resources</id>
            <phase>package</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/dist</outputDirectory>
              <resources>
                <resource>
                  <directory>${basedir}/src/main/resources/dist</directory>
                  <filtering>true</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Make scripts executable -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>make-scripts-executable</id>
            <phase>package</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <chmod dir="${project.build.directory}/dist/example" includes="*.sh" perm="755"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
